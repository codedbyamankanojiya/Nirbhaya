# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration (Prisma 7 + PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/nirbhaya?schema=public"

# JWT Token Configuration
JWT_ACCESS_SECRET="your-super-secret-access-token-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary Storage Configuration (Evidence Media Uploads)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Email Configuration (Nodemailer - Verification & Password Reset)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
EMAIL_FROM="noreply@nirbhaya.com"

# CORS Configuration (Next.js Frontend origin on port 3001)
CORS_ORIGIN="http://localhost:3001"

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
