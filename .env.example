# ==============================================================================
# Nirbhaya Flutter Mobile Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# API Base URL configuration:
# - For Android Emulator, use: http://10.0.2.2:3000
# - For Physical Android Device on same Wi-Fi, use machine IP: http://192.168.x.x:3000
# - For Web / iOS Simulator / Desktop, use: http://localhost:3000
API_BASE_URL="http://10.0.2.2:3000"
API_PREFIX="/api/v1"

# Environment: development | staging | production
APP_ENV="development"

# Google Gemini AI Free-Tier API Key (get free from https://aistudio.google.com)
# Can also be injected via build flag: --dart-define=GEMINI_API_KEY=YOUR_KEY
# or entered directly within the app Settings screen.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
