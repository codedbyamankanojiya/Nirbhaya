# ==============================================================================
# Nirbhaya Flutter Mobile Environment Configuration
# ==============================================================================

# API Base URL configuration:
# - For Android Emulator, use: http://10.0.2.2:3000
# - For Physical Android Device on same Wi-Fi, use your machine IP: http://192.168.x.x:3000
# - For Web / iOS Simulator / Desktop, use: http://localhost:3000
API_BASE_URL="http://10.0.2.2:3000"
API_PREFIX="/api/v1"

# Environment: development | staging | production
APP_ENV="development"

