# ==============================================================================
# Nirbhaya Git Attributes - Line Endings & Asset Integrity
# ==============================================================================

# Auto detect text files and perform LF normalization
* text=auto

# Source code files - force LF line endings
*.dart text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.prisma text eol=lf
*.html text eol=lf
*.css text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.env* text eol=lf
*.arb text eol=lf
*.rules text eol=lf

# Shell scripts - force LF for Linux/macOS execution
*.sh text eol=lf
*.bash text eol=lf

# Windows batch / cmd files - force CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - prevent Git from touching line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.mp3 binary
*.mp4 binary
*.m4a binary
*.wav binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.aar binary
*.so binary
*.dylib binary
*.dll binary
*.jks binary
*.keystore binary

# Linguist overrides (exclude generated or vendor files from GitHub language stats)
android/** linguist-vendored
ios/** linguist-vendored
windows/** linguist-vendored
macos/** linguist-vendored
linux/** linguist-vendored
*.g.dart linguist-generated=true
*.freezed.dart linguist-generated=true
