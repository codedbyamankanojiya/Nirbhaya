# Auto detect text files and perform LF normalization
* text=auto

# Source code files - normalize line endings to LF
*.dart text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.prisma text eol=lf
*.html text eol=lf
*.css text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.env* text eol=lf

# Shell scripts - force LF for Linux/macOS execution
*.sh text eol=lf
*.bash text eol=lf

# Windows batch / cmd files - force CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - prevent Git from touching line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.jar binary
*.aar binary
*.so binary
*.dylib binary
*.dll binary
*.jks binary
*.keystore binary
